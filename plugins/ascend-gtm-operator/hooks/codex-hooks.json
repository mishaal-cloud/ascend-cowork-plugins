{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT}/context/OPERATOR-CODEX.md\"",
            "timeout": 2,
            "statusMessage": "Loading Ascend operator context",
            "additionalContextLimit": 600
          }
        ]
      }
    ]
  }
}
